rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    match /strokes/{strokeId} {
      allow read: if true;
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.points.size() > 0 &&
                    request.resource.data.points.size() <= 200 &&
                    request.resource.data.createdAt == request.time;
    }

    match /presence/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && userId == request.auth.uid &&
                    request.resource.data.lastActive == request.time;
    }
  }
}
